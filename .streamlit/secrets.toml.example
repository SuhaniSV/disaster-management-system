# Copy this file to secrets.toml for local Streamlit secrets.
# On Streamlit Community Cloud, add the same keys in the app Secrets settings.
# Never commit secrets.toml or real credentials.

OPENAI_API_KEY = ""
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-4o-mini"

# Official government feeds. These remain unavailable until valid access is supplied.
# Get the token from the official IMD API portal; do not use a placeholder token.
IMD_API_TOKEN = ""
# Optional: only set these if the official IMD documentation for your issued access requires them.
# IMD_API_BASE = "https://api.imd.gov.in/api/v1"
# IMD_API_AUTH_HEADER = "Authorization"
# IMD_API_AUTH_SCHEME = "Bearer"

# Use only the authorized CAP/RSS feed URL provided by SACHET or the responsible agency.
NDMA_CAP_FEED_URL = ""

# Supabase PostgreSQL connection string (keep private; never commit a real value).
# DATABASE_URL = "postgresql://..."
