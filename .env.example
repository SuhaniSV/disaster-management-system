# Copy this file to .env and fill in values locally.
# Never commit real API keys.

# Optional LLM provider (OpenAI-compatible). Leave empty to use Fallback Analysis Mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Groq example:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# Optional AWS Builder mini-challenge (Amazon Bedrock)
# Configure AWS credentials separately using your local AWS profile or IAM role.
# AWS_REGION=us-east-1
# AWS_BEDROCK_MODEL_ID=

# Official live government hazard feeds (optional)
# Obtain IMD API access and an issued token through the official IMD API portal.
IMD_API_TOKEN=
# Optional override only when documented by IMD:
# IMD_API_BASE=https://api.imd.gov.in/api/v1

# Optional: use only the authorized public feed URL provided by NDMA SACHET.
NDMA_CAP_FEED_URL=

# Optional driving route provider. Defaults to OSRM public demo (not for emergency-grade use).
# RESQ_ROUTING_BASE_URL=https://router.project-osrm.org

# Optional operator-triggered email (never auto-sends)
RESQ_SMTP_HOST=
RESQ_SMTP_PORT=587
RESQ_SMTP_FROM=
RESQ_SMTP_USERNAME=
RESQ_SMTP_PASSWORD=
RESQ_ALERT_EMAIL_TO=
